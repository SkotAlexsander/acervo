# Modelo do arquivo de assinatura do APK.
#
# Copie para `keystore.properties` (na mesma pasta) e preencha com os seus
# dados. O arquivo real e o `.keystore` ficam de fora do repositório.
#
# Pra criar uma chave nova:
#
#   keytool -genkey -v -keystore acervo.keystore -alias acervo \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# (o `keytool` vem junto com o Java; no Windows fica em
#  <pasta do JDK>\bin\keytool.exe)
#
# GUARDE ESSA CHAVE. Perder a chave de um app já instalado significa que a
# próxima versão não vai poder ser instalada por cima — o Android recusa
# atualização assinada por outra chave, e a única saída é desinstalar,
# perdendo os dados do app.

# Caminho do .keystore, relativo à pasta android/app/
storeFile=../acervo.keystore
storePassword=TROQUE-AQUI
keyAlias=acervo
keyPassword=TROQUE-AQUI
